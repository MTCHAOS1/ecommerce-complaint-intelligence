# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# O provisionador preenche estes campos com uma conta restrita.
# Administração fica em .env.minio-admin, usando .env.minio-admin.example.

MINIO_ENDPOINT=http://127.0.0.1:9000

# PostgreSQL 15+ (instalado separadamente; Compose provisiona apenas MinIO)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_complaints
DB_USER=complaints_user
DB_PASSWORD=sua_senha_postgresql

# Dashboard: configure os dois para usar um login SELECT separado.
# Sem ambos, mantém DB_USER/DB_PASSWORD para compatibilidade local.
# DASHBOARD_DB_USER=complaints_dashboard
# DASHBOARD_DB_PASSWORD=sua_senha_dashboard

# Integrações opcionais: escolha um modo (desabilitadas por padrão).
# Local: cria cluster próprio sem usar DB_* (requer binários PostgreSQL 15+).
# RUN_TEMP_POSTGRES_TESTS=1
# Servidor de testes: banco de controle existente, diferente de DB_NAME.
# O usuário DB_USER precisa de CREATEDB; cada grupo cria/remove seu próprio banco aleatório.
# TEST_DB_NAME=ecommerce_complaints_test
